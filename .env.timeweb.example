# Copy locally to .env.timeweb; NEVER COMMIT actual credentials.
PROIDU_HOST=proidu.example.ru
DATABASE_URL=postgresql://proidu_app:REPLACE_ME@10.0.0.10:5432/proidu?sslmode=require
PG_POOL_MAX=5

# Factory bridge disabled unless --profile factory-bridge is selected.
# Set securely only in private VPS env; never in Git.
# AI_BRIDGE_DATABASE_URL=postgresql://...
# AI_FACTORY_SHARED_SECRET=minimum-32-characters
PROIDU_COLLECTOR_ENABLED=false
PROIDU_COLLECTOR_INTERVAL_SECONDS=120
